{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".build",
    "rootDir": ".",
    "types": [],
    "noEmitOnError": true
  },
  "include": [
    "solutions/**/*.ts",
    "starters/**/*.ts",
    "types/**/*.ts"
  ]
}